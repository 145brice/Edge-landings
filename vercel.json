{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "lawyer-template/**",
      "use": "@vercel/static"
    },
    {
      "src": "lawyer-template/assets/css/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "lawyer-template/assets/js/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "public/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "public/*.css",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/reddit-lead-feed.js",
      "dest": "/public/reddit-lead-feed.js"
    },
    {
      "src": "/pro-lead-feed.css",
      "dest": "/public/pro-lead-feed.css"
    },
    {
      "src": "/lawyer-template/assets/css/(.*)",
      "dest": "/lawyer-template/assets/css/$1"
    },
    {
      "src": "/lawyer-template/assets/js/(.*)",
      "dest": "/lawyer-template/assets/js/$1"
    },
    {
      "src": "/(.*\\.html)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "crons": [{ "path": "/api/catalog-webhook", "schedule": "0 9 * * 1" }]
}
