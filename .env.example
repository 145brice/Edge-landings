# Public, canonical HTTPS URL for this deployment. No trailing slash.
APP_URL=https://your-domain.example

# Stripe: create recurring Basic ($99) and Growth ($199) monthly Prices.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Resend: EMAIL_FROM must be a verified Resend sender.
EMAIL_API_KEY=re_replace_me
EMAIL_FROM=Edge Landings <onboarding@your-domain.example>
OWNER_EMAIL=owner@your-domain.example

# Optional Google Apps Script endpoint. When set, onboarding is also posted there.
GOOGLE_SCRIPT_URL=

# Internal pricing catalog. Keep both secrets server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
ESTIMATOR_WEBHOOK_SECRET=replace_with_a_long_random_value
CRON_SECRET=replace_with_a_different_long_random_value
# Catalog slug -> Stripe Price ID. Synced during the baseline refresh job.
STRIPE_PRICE_MAP={"basic":"price_basic_replace_me","growth":"price_growth_replace_me"}

# Trial contractor-opportunity feed. The URL must be a read-only endpoint exposed
# by the existing Reddit scraper; the optional token is sent only server-to-server.
REDDIT_LEAD_FEED_ENABLED=false
REDDIT_LEAD_FEED_URL=https://your-reddit-scraper.example/api/leads
REDDIT_LEAD_FEED_TOKEN=
